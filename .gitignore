# ===================================================================
# فایل‌های نادیده‌گرفته‌شده توسط گیت
# هر خطی که اینجا بنویسید، گیت تغییراتش را دنبال نمی‌کند.
# ===================================================================

# فایل‌های تست شخصی (test.ts و test.js در هر زیرپوشه‌ای از backend)
backend/**/test.ts
backend/**/test.js

# وابستگی‌ها (سنگین‌اند و با npm install دوباره ساخته می‌شوند)
node_modules/

# خروجی build (تولیدشده، نه دست‌نویس)
frontend/.next/
backend/dist/

# فایل‌های محیطی — محرمانه! (رمز دیتابیس و JWT_SECRET داخلشان است)
.env
.env.local

# فایل‌های سیستمی ماک/لینوکس
.DS_Store
