# آدرس اتصال به دیتابیس PostgreSQL
DATABASE_URL=postgres://parts_user:parts_pass@localhost:5432/parts_db

# رشته محرمانه برای امضای توکن‌های JWT (در محیط واقعی یک رشته طولانی تصادفی بگذارید)
JWT_SECRET=change-me-to-a-long-random-string-in-production

# پورتی که سرور Express روی آن اجرا می‌شود
PORT=4000

# آدرس فرانت‌اند برای تنظیم CORS
FRONTEND_URL=http://localhost:3000

# هزینه ارسال ثابت (تومان) — سبد بالای آستانه، ارسال رایگان دارد
SHIPPING_COST=60000
FREE_SHIPPING_THRESHOLD=5000000

# اطلاعات کارت فروشگاه برای پرداخت کارت‌به‌کارت
SHOP_CARD_NUMBER=6037-9975-XXXX-XXXX
SHOP_CARD_HOLDER=فروشگاه قطعات خودرو
